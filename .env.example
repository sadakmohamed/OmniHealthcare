# OmniHealthcare Environment Configuration
# Copy to .env and set values before running

# Django settings
DJANGO_SECRET_KEY=change-me-use-a-long-random-string-at-least-50-chars
VIRTUALCARE_SYNC_SECRET=change-me-use-a-separate-long-random-secret
VIRTUALCARE_BOOTSTRAP_KEY=set-a-one-time-virtual-care-admin-bootstrap-secret
# For separately hosted services, point Virtual Care to the trusted hospital identity endpoint.
HOSPITAL_IDENTITY_URL=http://127.0.0.1:8000/api/v1/me/
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,virtualcare,your-domain.com

# Database (PostgreSQL for production, omit for SQLite dev)
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://omnihealth:your_secure_password@localhost:5432/omnihealth
VIRTUALCARE_POSTGRES_PASSWORD=your_separate_secure_password
VIRTUALCARE_DATABASE_URL=postgresql://virtualcare:your_separate_secure_password@localhost:5432/virtualcare

# CORS/CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Frontend (for production build)
VITE_API_BASE_URL=https://your-domain.com/api/v1
VITE_VIRTUAL_CARE_API_URL=https://your-domain.com/virtual-api/api/v1

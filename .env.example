# OmniHealthcare Environment Configuration
# Copy to .env and set values before running

# Django settings
DJANGO_SECRET_KEY=change-me-use-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database (PostgreSQL for production, omit for SQLite dev)
DATABASE_URL=postgresql://omnihealth:your_secure_password@localhost:5432/omnihealth

# CORS/CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Frontend (for production build)
VITE_API_BASE=https://your-domain.com/api/v1
